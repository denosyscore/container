{
  "name": "denosyscore/container",
  "description": "PSR-11 compliant dependency injection container with autowiring, contextual bindings, and service decorators for PHP 8.2+",
  "type": "library",
  "keywords": [
    "dependency-injection",
    "container",
    "psr-11",
    "autowiring",
    "di-container",
    "ioc",
    "service-container",
    "php"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "psr/container": "^2.0",
    "denosyscore/contracts": "^0.2",
    "denosyscore/events": "^0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Container\\": "src/Container/",
      "Denosys\\Container\\Exceptions\\": "src/Exceptions/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Denosys\\Container\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
