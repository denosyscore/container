{
  "name": "denosyscore/container",
  "description": "Dependency injection container and tooling",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "psr/container": "^2.0",
    "denosyscore/contracts": "^0.2",
    "denosyscore/events": "^0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "Denosys\\Container\\": "src/Container/",
      "Denosys\\Container\\Exceptions\\": "src/Exceptions/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Denosys\\Container\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
